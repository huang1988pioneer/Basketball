; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="喵萌籃球大作戰"
config/version="1.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/generated-app-icon-v2.png"
boot_splash/image="res://assets/generated-launch-splash-v2.png"
boot_splash/bg_color=Color(0.0196, 0.0392, 0.102, 1)
boot_splash/show_image=true
boot_splash/fullsize=true
boot_splash/use_filter=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=820
window/size/window_width_override=1280
window/size/window_height_override=820
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[gui]

theme/default_font_multichannel_signed_distance_field=true

